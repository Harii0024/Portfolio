# Frontend — only public API base for browser if not using rewrites.
# Prefer Next rewrites: leave NEXT_PUBLIC_API_BASE empty so fetch('/api/...') stays same-origin.

# Server-side absolute URL to Python API (RSC / SSR)
BACKEND_URL=http://127.0.0.1:8000

# Optional: set only if you call the API cross-origin from the browser
# NEXT_PUBLIC_API_BASE=http://127.0.0.1:8000
